{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Home-screen name from Info.plist ($(APP_DISPLAY_NAME) in ios/project.yml, \"Jirka's Arc\"). A brand name, the same in every language: no translation on purpose, since a Czech value here would override the build setting (rebrand-to-jirkas-arc D2).",
      "extractionState" : "manual",
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "comment" : "Bundle name from Info.plist; the product name is not translated.",
      "extractionState" : "manual",
      "shouldTranslate" : false
    },
    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt (Info.plist key; the English text is the value in ios/project.yml). Shown before barcode scanning. Mode-neutral since add-standalone-mode 5.6 (no Garmin in standalone mode).",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jirka's Arc používá fotoaparát ke skenování čárového kódu výrobku a k jeho vyhledání v databázích potravin."
          }
        }
      }
    },
    "Jirka's Arc love pack" : {
      "comment" : "The love pack file type, from Info.plist (UTTypeDescription and CFBundleTypeName in ios/project.yml; add-partner-love-theme D1). Shown by Files and AirDrop.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balíček lásky Jirka's Arc"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
